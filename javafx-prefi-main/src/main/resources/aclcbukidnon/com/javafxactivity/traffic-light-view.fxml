<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox fx:controller="aclcbukidnon.com.javafxactivity.controllers.TrafficLightController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="200"
      prefHeight="500"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">

   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>

   <!-- Traffic Light Housing -->
   <VBox spacing="15" style="-fx-background-color: black; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;" alignment="CENTER">
      <Circle fx:id="redLight" radius="40" fill="#2f2f2f" stroke="white" strokeWidth="2"/>
      <Circle fx:id="yellowLight" radius="40" fill="#2f2f2f" stroke="white" strokeWidth="2"/>
      <Circle fx:id="greenLight" radius="40" fill="#2f2f2f" stroke="white" strokeWidth="2"/>
   </VBox>

   <!-- Controls -->
   <Button fx:id="toggleModeButton" text="Switch to Manual" onAction="#toggleMode"/>
   <Button fx:id="nextLightButton" text="Next Light" onAction="#nextLight" disable="true"/>
</VBox>
